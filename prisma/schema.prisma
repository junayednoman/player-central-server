generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                         String                     @id @default(uuid())
  email                      String                     @unique
  password                   String
  role                       UserRole
  status                     UserStatus                 @default(PENDING)
  loginProvider              LoginProvider
  fcmToken                   String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  playerBookingApprovals     BookingApprovalRequest[]   @relation("PlayerBookingApprovals")
  coachChallenges            Challenge[]                @relation("CoachChallenges")
  playerChallengeApprovals   ChallengeApprovalRequest[] @relation("PlayerChallengeApprovals")
  challengeComments          ChallengeComment[]         @relation("ChallengeComments")
  challengeReactions         ChallengeReaction[]        @relation("ChallengeReactions")
  playerChildren             Child[]                    @relation("PlayerChildren")
  coachAvailabilityBlocks    CoachAvailabilityBlock[]   @relation("CoachAvailabilityBlocks")
  coachProfile               CoachProfile?
  comments                   Comment[]
  conversationParticipants   ConversationParticipant[]
  coachCustomSessionBookings CustomSessionBooking[]     @relation("CoachCustomSessionBookings")
  followerRelations          Following[]                @relation("FollowingFollower")
  followingRelations         Following[]                @relation("FollowingFollowing")
  playerInvitations          Invitation[]               @relation("PlayerInvitations")
  scoutInvitations           Invitation[]               @relation("ScoutInvitations")
  sentMessages               Message[]                  @relation("MessageSender")
  parentProfile              ParentProfile?
  payments                   Payment[]
  coachBookmarks             PlayerBookmark[]           @relation("CoachBookmarks")
  playerBookmarks            PlayerBookmark[]           @relation("PlayerBookmarks")
  playerProfile              PlayerProfile?
  playerShortlists           PlayerShortlist[]          @relation("PlayerShortlists")
  scoutShortlists            PlayerShortlist[]          @relation("ScoutShortlists")
  playerPosts                Post[]                     @relation("PlayerPosts")
  playerPostApprovals        PostApprovalRequest[]      @relation("PlayerPostApprovals")
  postShares                 PostShare[]
  reactions                  Reaction[]
  reports                    Report[]                   @relation("ReporterReports")
  coachReviews               Review[]                   @relation("CoachReviews")
  playerReviewsGiven         Review[]                   @relation("PlayerReviewsGiven")
  scoutProfile               ScoutProfile?
  coachSessionBookings       SessionBooking[]           @relation("CoachSessionBookings")
  playerSessionBookings      SessionBooking[]           @relation("PlayerSessionBookings")
  subscription               Subscription?
  supportMessages            SupportMessage[]
  ParentToChildren           ParentToChildren[]
  bookmarkedChallenges       ChallengeBookmark[]        @relation("ChallengeBookmarks")
  challengeSubmissions       ChallengeSubmission[]      @relation("ChallengeSubmissions")
  notifications              Notification[]
  otp                        OTP?
  profile                    Profile?
  child                      Child?                     @relation(fields: [childId], references: [id])
  childId                    String?
  children                   Child[]                    @relation("ParentToChildren")
  customSessionPlayers       CustomSessionBooking[]     @relation("CustomSessionPlayers")
  childApprovalRequests      ChildApprovalRequest[]     @relation("ChildApprovals")

  @@map("auth")
}

model OTP {
  id                String     @id @default(uuid())
  authId            String     @unique
  otp               String
  expires           DateTime
  attempts          Int        @default(0)
  isVerified        Boolean    @default(false)
  createdAt         DateTime   @default(now())
  purpose           OTPPurpose
  resetTokenExpires DateTime?
  resetTokenHash    String?
  auth              Auth       @relation(fields: [authId], references: [id])

  @@unique([authId, purpose])
  @@map("otp")
}

model Profile {
  id        String   @id @default(uuid())
  authId    String   @unique
  name      String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auth      Auth     @relation(fields: [authId], references: [id])

  @@map("profiles")
}

model PlayerProfile {
  id                  String         @id @default(uuid())
  authId              String         @unique
  dob                 DateTime
  height              String
  position            PlayerPosition
  bio                 String
  completedChallenges Int            @default(0)
  uploadStreaks       Int            @default(0)
  shortListedCount    Int            @default(0)
  invitationCount     Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  auth                Auth           @relation(fields: [authId], references: [id])
}

model CoachProfile {
  id           String             @id @default(uuid())
  authId       String             @unique
  experience   Int
  location     String
  teams        String[]
  certificate  String
  price        Float
  sessionTypes CoachSessionType[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  mode         CoachSessionMode
  intro        String?
  auth         Auth               @relation(fields: [authId], references: [id])
}

model ScoutProfile {
  id           String     @id @default(uuid())
  authId       String     @unique
  organization String
  level        ScoutLevel
  badge        String
  intro        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auth         Auth       @relation(fields: [authId], references: [id])
}

model ParentProfile {
  id             String   @id @default(uuid())
  authId         String   @unique
  defaultChildId String?
  phone          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  auth           Auth     @relation(fields: [authId], references: [id])
}

model CoachAvailabilityBlock {
  id          String                       @id @default(uuid())
  type        CoachAvailabilityType
  isRecurring Boolean
  dayOfWeek   CoachAvailabilityDaysOfWeek?
  startTime   DateTime?                    @db.Time(6)
  endTime     DateTime?                    @db.Time(6)
  startAt     DateTime?                    @db.Timestamptz(6)
  endAt       DateTime?                    @db.Timestamptz(6)
  validFrom   DateTime?                    @db.Date
  validUntil  DateTime?                    @db.Date
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  coachAuthId String
  coach       Auth                         @relation("CoachAvailabilityBlocks", fields: [coachAuthId], references: [id])
}

model Challenge {
  id               String                     @id @default(uuid())
  category         PlayerPosition
  video            String
  title            String
  instruction      String
  difficulty       ChallengeDifficulty
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  coachAuthId      String
  shareCount       Int                        @default(0)
  coach            Auth                       @relation("CoachChallenges", fields: [coachAuthId], references: [id])
  approvalRequests ChallengeApprovalRequest[]
  comments         ChallengeComment[]
  reactions        ChallengeReaction[]
  reports          Report[]
  bookmarks        ChallengeBookmark[]
  submissions      ChallengeSubmission[]
}

model ChallengeBookmark {
  id           String    @id @default(uuid())
  challengeId  String
  playerAuthId String
  createdAt    DateTime  @default(now())
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  player       Auth      @relation("ChallengeBookmarks", fields: [playerAuthId], references: [id])

  @@unique([challengeId, playerAuthId])
  @@map("challenge_bookmark")
}

model ChallengeSubmission {
  id          String    @id @default(uuid())
  challengeId String
  playerId    String    @map("playerId")
  video       String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  player      Auth      @relation("ChallengeSubmissions", fields: [playerId], references: [id])

  @@map("challenge_submission")
}

model ChallengeReaction {
  id          String    @id @default(uuid())
  challengeId String
  authId      String
  createdAt   DateTime  @default(now())
  auth        Auth      @relation("ChallengeReactions", fields: [authId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model ChallengeComment {
  id          String    @id @default(uuid())
  challengeId String
  authorId    String
  text        String
  isEdited    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  author      Auth      @relation("ChallengeComments", fields: [authorId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model SessionBooking {
  id               String                   @id @default(uuid())
  sessionType      CoachSessionType
  sessionMode      CoachSessionMode
  startAt          DateTime
  endAt            DateTime
  status           CoachingSessionStatus
  bookedAt         DateTime                 @default(now())
  coachAuthId      String
  playerAuthId     String
  createdAt        DateTime                 @default(now())
  reservedUntil    DateTime?
  approvalRequests BookingApprovalRequest[]
  payment          Payment?
  coach            Auth                     @relation("CoachSessionBookings", fields: [coachAuthId], references: [id])
  player           Auth                     @relation("PlayerSessionBookings", fields: [playerAuthId], references: [id])
}

model CustomSessionBooking {
  id          String                @id @default(uuid())
  sessionType CoachSessionType
  maxPlayers  Int
  mode        CoachSessionMode
  startAt     DateTime
  endAt       DateTime
  status      CoachingSessionStatus
  bookedAt    DateTime              @default(now())
  coachAuthId String
  coach       Auth                  @relation("CoachCustomSessionBookings", fields: [coachAuthId], references: [id])
  players     Auth[]                @relation("CustomSessionPlayers")
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String?         @unique
  payerAuthId       String
  amount            Float
  currency          String          @default("usd")
  provider          String          @default("stripe")
  providerIntentId  String?
  status            PaymentStatus   @default(PENDING)
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  postId            String?         @unique
  providerInvoiceId String?         @unique
  subscriptionId    String?
  type              PaymentType
  booking           SessionBooking? @relation(fields: [bookingId], references: [id])
  payer             Auth            @relation(fields: [payerAuthId], references: [id])
  post              Post?           @relation("PostPayments", fields: [postId], references: [id])
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
}

model SubscriptionPlan {
  id              String               @id @default(uuid())
  role            UserRole
  name            String
  price           Float
  currency        String               @default("usd")
  interval        SubscriptionInterval @default(MONTHLY)
  features        String[]
  isActive        Boolean              @default(true)
  stripeProductId String?
  stripePriceId   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  authId                 String             @unique
  planId                 String
  status                 SubscriptionStatus
  provider               String             @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               Payment[]
  auth                   Auth               @relation(fields: [authId], references: [id])
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
}

model Invitation {
  id             String   @id @default(uuid())
  trialDate      DateTime
  street         String
  buildingNumber String
  postCode       String
  instruction    String
  sentAt         DateTime @default(now())
  playerAuthId   String
  scoutAuthId    String
  player         Auth     @relation("PlayerInvitations", fields: [playerAuthId], references: [id])
  scout          Auth     @relation("ScoutInvitations", fields: [scoutAuthId], references: [id])
}

model Post {
  id               String                @id @default(uuid())
  caption          String
  video            String
  type             PostType
  status           PostStatus
  shareCount       Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  playerAuthId     String
  comments         Comment[]
  payment          Payment?              @relation("PostPayments")
  player           Auth                  @relation("PlayerPosts", fields: [playerAuthId], references: [id])
  approvalRequests PostApprovalRequest[]
  shares           PostShare[]
  reactions        Reaction[]
  reports          Report[]
}

model Reaction {
  id     String @id @default(uuid())
  postId String
  authId String
  auth   Auth   @relation(fields: [authId], references: [id])
  post   Post   @relation(fields: [postId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String
  text      String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  author    Auth     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model PostShare {
  id        String   @id @default(uuid())
  postId    String
  authId    String
  createdAt DateTime @default(now())
  auth      Auth     @relation(fields: [authId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, authId])
}

model Following {
  id              String @id @default(uuid())
  followerAuthId  String
  followingAuthId String
  follower        Auth   @relation("FollowingFollower", fields: [followerAuthId], references: [id])
  following       Auth   @relation("FollowingFollowing", fields: [followingAuthId], references: [id])
}

model PlayerBookmark {
  id           String @id @default(uuid())
  coachAuthId  String
  playerAuthId String
  coach        Auth   @relation("CoachBookmarks", fields: [coachAuthId], references: [id])
  player       Auth   @relation("PlayerBookmarks", fields: [playerAuthId], references: [id])

  @@unique([coachAuthId, playerAuthId])
}

model PlayerShortlist {
  id           String   @id @default(uuid())
  playerAuthId String
  scoutAuthId  String
  createdAt    DateTime @default(now())
  player       Auth     @relation("PlayerShortlists", fields: [playerAuthId], references: [id])
  scout        Auth     @relation("ScoutShortlists", fields: [scoutAuthId], references: [id])

  @@unique([scoutAuthId, playerAuthId])
}

model BookingApprovalRequest {
  id           String                @id @default(uuid())
  bookingId    String
  status       ApprovalRequestStatus
  requestedAt  DateTime              @default(now())
  playerAuthId String
  booking      SessionBooking        @relation(fields: [bookingId], references: [id])
  player       Auth                  @relation("PlayerBookingApprovals", fields: [playerAuthId], references: [id])
}

model PostApprovalRequest {
  id           String                @id @default(uuid())
  postId       String
  status       ApprovalRequestStatus
  requestedAt  DateTime              @default(now())
  playerAuthId String
  player       Auth                  @relation("PlayerPostApprovals", fields: [playerAuthId], references: [id])
  post         Post                  @relation(fields: [postId], references: [id])
}

model ChallengeApprovalRequest {
  id           String                @id @default(uuid())
  challengeId  String
  status       ApprovalRequestStatus
  requestedAt  DateTime              @default(now())
  playerAuthId String
  video        String?
  challenge    Challenge             @relation(fields: [challengeId], references: [id])
  player       Auth                  @relation("PlayerChallengeApprovals", fields: [playerAuthId], references: [id])
}

model Review {
  id          String   @id @default(uuid())
  text        String
  rating      Float
  givenAt     DateTime @default(now())
  coachAuthId String
  giverAuthId String
  coach       Auth     @relation("CoachReviews", fields: [coachAuthId], references: [id])
  giver       Auth     @relation("PlayerReviewsGiven", fields: [giverAuthId], references: [id])
}

model Child {
  id                    String                 @id @default(uuid())
  relationship          ChildRelationShip
  status                ChildStatus
  parents               Auth[]                 @relation("ParentToChildren")
  playerAuthId          String
  whoCanComment         ChildAccessScope       @default(EVERYONE)
  whoCanFollow          ChildAccessScope       @default(EVERYONE)
  player                Auth                   @relation("PlayerChildren", fields: [playerAuthId], references: [id])
  ParentToChildren      ParentToChildren[]
  auths                 Auth[]
  childApprovalRequests ChildApprovalRequest[]
}

model ChildApprovalRequest {
  id                String   @id @default(uuid())
  childId           String
  child             Child    @relation(fields: [childId], references: [id])
  requesterParentId String
  requesterParent   Auth     @relation("ChildApprovals", fields: [requesterParentId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([childId, requesterParentId])
}

model Notification {
  id         String   @id @default(uuid())
  receiverId String
  title      String
  body       String
  date       DateTime @default(now())
  receiver   Auth     @relation(fields: [receiverId], references: [id])

  @@map("notification")
}

model Legal {
  id                        String   @id @default(uuid())
  privacyPolicy             String
  termsCondition            String
  aboutUs                   String
  updatedAt                 DateTime @updatedAt
  sessionCancellationPolicy String

  @@map("legal")
}

model PremiumPostConfig {
  id        String   @id @default(uuid())
  price     Float
  currency  String   @default("usd")
  features  String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(uuid())
  image     String
  caption   String
  hashtags  String[]
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("News")
}

model SupportMessage {
  id           String   @id @default(uuid())
  senderAuthId String
  subject      String
  description  String
  createdAt    DateTime @default(now())
  sender       Auth     @relation(fields: [senderAuthId], references: [id])
}

model Report {
  id             String            @id @default(uuid())
  reporterAuthId String
  reason         String
  contentType    ReportContentType
  postId         String?
  challengeId    String?
  createdAt      DateTime          @default(now())
  challenge      Challenge?        @relation(fields: [challengeId], references: [id])
  post           Post?             @relation(fields: [postId], references: [id])
  reporter       Auth              @relation("ReporterReports", fields: [reporterAuthId], references: [id])

  @@unique([reporterAuthId, postId])
  @@unique([reporterAuthId, challengeId])
}

model Conversation {
  id            String                    @id @default(uuid())
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  authId         String
  lastReadAt     DateTime?
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  auth           Auth         @relation(fields: [authId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, authId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderAuthId   String
  text           String
  type           MessageType  @default(TEXT)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         Auth         @relation("MessageSender", fields: [senderAuthId], references: [id])
}

model ParentToChildren {
  A     String
  B     String
  auth  Auth   @relation(fields: [A], references: [id], onDelete: Cascade)
  Child Child  @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ParentToChildren_AB_pkey")
  @@index([B], map: "_ParentToChildren_B_index")
  @@map("_ParentToChildren")
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum LoginProvider {
  FACEBOOK
  GOOGLE
  EMAIL
}

enum UserRole {
  ADMIN
  PLAYER
  COACH
  SCOUT
  PARENT
}

enum PlayerPosition {
  MIDFIELDER
  ATTACKER
  DEFENDER
  GOALKEEPER
}

enum CoachSessionType {
  ONE_TO_ONE
  GROUP
  SKILL_BASED
}

enum CoachSessionMode {
  PLAYER_TRAVELS
  COACH_TRAVELS
}

enum ScoutLevel {
  LOCAL
  REGIONAL
  NATIONAL
}

enum CoachAvailabilityType {
  AVAILABLE
  BLACKOUT
}

enum CoachAvailabilityDaysOfWeek {
  D0
  D1
  D2
  D3
  D4
  D5
  D6
}

enum ChildRelationShip {
  FATHER
  MOTHER
  UNCLE
  OTHER
}

enum ChildStatus {
  PENDING
  APPROVED
}

enum ChildAccessScope {
  EVERYONE
  COACH
  SCOUT
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PostType {
  COMMUNITY
  PREMIUM
}

enum PostStatus {
  PENDING
  APPROVED
  PENDING_PAYMENT
}

enum CoachingSessionStatus {
  PENDING
  APPROVED
  UPCOMING
  COMPLETED
  PENDING_PAYMENT
  EXPIRED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentType {
  BOOKING
  POST
  SUBSCRIPTION
}

enum SubscriptionInterval {
  MONTHLY
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum MessageType {
  TEXT
}

enum ReportContentType {
  COMMUNITY_POST
  PREMIUM_POST
  CHALLENGE
}

enum OTPPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}
